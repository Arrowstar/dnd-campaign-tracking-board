# DATABASE_URL: Required. Neon (Postgres) connection string used for all
# persistence. Falls back to POSTGRES_URL or POSTGRES_PRISMA_URL if unset.
DATABASE_URL="postgresql://user:password@host/db"

# APP_URL: The public URL where the app is hosted.
# Used for self-referential links and share links.
APP_URL="http://localhost:3000"

# BLOB_READ_WRITE_TOKEN: Vercel Blob storage token. Required for uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Rate-limit tuning (docs/SECURITY-AUDIT.md medium #6). All optional; defaults shown.
# LOGIN_RATE_LIMIT=10            # login attempts per IP+username per 15 min
# LOGIN_RATE_LIMIT_PER_IP=30     # login attempts per IP per 15 min
# REGISTER_RATE_LIMIT=5          # registrations per IP per hour
# JOIN_RATE_LIMIT=10             # board-password attempts per IP+user per 15 min
# PASSWORD_CHANGE_RATE_LIMIT=10  # password-change attempts per IP+user per 15 min
